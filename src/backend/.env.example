# Copy to .env (never commit that file). Use URL-safe generated secrets.
POSTGRES_DB=smart_locker
POSTGRES_USER=locker_dev
POSTGRES_PASSWORD=replace-with-random-db-password
DATABASE_URL=postgresql+psycopg://locker_dev:replace-with-random-db-password@127.0.0.1:5432/smart_locker
JWT_SECRET=replace-with-random-jwt-secret-at-least-32-bytes
JWT_ISSUER=smart-locker-auth
JWT_AUDIENCE=smart-locker-api
JWT_TTL_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Used only by the explicit --demo seed command; different passwords.
DEMO_COURIER_PASSWORD=replace-with-demo-courier-password
DEMO_ADMIN_PASSWORD=replace-with-demo-admin-password
