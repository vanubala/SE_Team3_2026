PICKUP_NOTIFICATION_PROVIDER=console

# Twilio Programmable Messaging (API key credentials recommended)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
# Use a Messaging Service SID instead of TWILIO_FROM_NUMBER when configured.
TWILIO_MESSAGING_SERVICE_SID=

# Twilio SendGrid Mail Send
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Use https://api.eu.sendgrid.com only with an EU regional SendGrid subuser.
SENDGRID_API_BASE_URL=https://api.sendgrid.com

# Keep this stable and identical to UC4's pickup-code verifier.
PICKUP_CODE_SECRET=
